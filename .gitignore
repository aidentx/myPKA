# myPKA repository ignore list (repo-only: never installed into a member folder).
# Lines taken from the ICOR for Life Scaffold 1.34.1 .gitignore, team part only.
.env
.claude/settings.local.json
.DS_Store

# The machine layer: per device and regenerated. Only the files that describe
# the release are kept.
.mypka/*
!.mypka/VERSION
!.mypka/manifest.json
!.mypka/sources.yaml.example
!.mypka/sources.mode-b.yaml.example
!.mypka/icor-concepts-1.json
!.mypka/CHANGELOG.md

# Team state (session.json, receipts/, harness.json) lives in .mypka/state/
# since ruling j5d and its 2026-09-24 extension, covered by .mypka/* above.
# No team script writes under .icor-for-life/scripts/ any more; that folder is
# the content source's life_state and its own repo ignores it.

# The host link layer written by scaffold-init.py apply (per device).
.agents/skills/

# Python bytecode
__pycache__/
*.pyc

# Proof fixtures written by the updater-poc scripts when they run.
06 AI Team/AI Team Knowledge/Scripts/tests/updater-poc/w*/
06 AI Team/AI Team Knowledge/Scripts/tests/updater-poc/v[0-9]*/

# The member's overrides and the updater's own output (Marshall C). Never
# tracked, never shipped; both builders refuse to ship either suffix.
*.local.md
*.update

# Member records never belong in the public product repo. The member's vault is
# a separate private repo (GAP 2, 2026-10-01); this block is the backstop for a
# stray `git add -A` here. Files already tracked (the shipped seed journals and
# the .gitkeep files) stay tracked: ignore rules only stop NEW files.
06 AI Team/AI Team Knowledge/Session Logs/**
!06 AI Team/AI Team Knowledge/Session Logs/**/
!06 AI Team/AI Team Knowledge/Session Logs/**/.gitkeep
06 AI Team/AI Team Knowledge/Tasks/**
!06 AI Team/AI Team Knowledge/Tasks/**/
!06 AI Team/AI Team Knowledge/Tasks/**/.gitkeep
06 AI Team/Agents/*/Journal/*
!06 AI Team/Agents/*/Journal/_template.md
!06 AI Team/Agents/*/Journal/.gitkeep
# Device-local state.
.obsidian/
06 AI Team/AI Team Knowledge/.onboarded
